# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud > App settings > Secrets.
TAVILY_API_KEY = "tvly-..."
NEBIUS_API_KEY = "..."
NEBIUS_MODEL = "nvidia/nemotron-3-super-120b-a12b"
SUPABASE_URL = "https://your-project.supabase.co"
# service_role key: server-side only. Never expose it in client code or commit it.
SUPABASE_KEY = "your-supabase-service-role-key"
# DEMO_SIMULATION = "true"   # leave unset for live mode; "true" shows fake data under a red banner

# Alerts (optional)
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/..."
APP_URL = "https://your-app.streamlit.app"
# SMTP_HOST = ""
# SMTP_PORT = "587"
# SMTP_USER = ""
# SMTP_PASSWORD = ""
# ALERT_EMAIL_TO = ""
