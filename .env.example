# PulseGrid AI - API Credentials (copy to .env; never commit .env)
TAVILY_API_KEY=your_tavily_api_key_here

# Nebius Token Factory (OpenAI-compatible): https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_API_KEY=your_nebius_api_key_here
# Verify valid IDs with: python check_models.py
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Supabase for snapshot diffing (falls back to a local JSON file)
SUPABASE_URL=https://your-project.supabase.co
# service_role key: server-side only, never commit it
SUPABASE_KEY=your_supabase_service_role_key_here

# Set to true ONLY to demo the UI with fake data (shows a red SIMULATED banner)
# DEMO_SIMULATION=true
